{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits"],
  "timezone": "Asia/Shanghai",
  "schedule": ["after 6am and before 7am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "description": "Auto-merge non-major updates (minor, patch, lockfile)",
      "matchUpdateTypes": ["minor", "patch", "lockFileMaintenance"],
      "groupName": "all non-major ({{manager}})",
      "automerge": true
    },
    {
      "description": "Group digest updates and require human review",
      "matchUpdateTypes": ["digest"],
      "groupName": "all digests ({{manager}})"
    },
    {
      "description": "Separate PRs for major GitHub Action updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"]
    }
  ]
}
